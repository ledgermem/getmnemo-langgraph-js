{
  "name": "getmnemo-langgraph",
  "version": "0.1.0",
  "description": "Mnemo-backed long-term memory for LangGraph JS — a BaseStore implementation plus remember/recall tools.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "smoke": "node scripts/prod-smoke.mjs"
  },
  "keywords": [
    "getmnemo",
    "langgraph",
    "langchain",
    "memory",
    "store",
    "agent",
    "rag"
  ],
  "author": {
    "name": "Mnemo",
    "url": "https://mnemohq.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ledgermem/getmnemo-langgraph.git"
  },
  "bugs": {
    "url": "https://github.com/ledgermem/getmnemo-langgraph/issues"
  },
  "dependencies": {
    "getmnemo": "^0.5.0"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.3.0 <2.0.0",
    "@langchain/langgraph": ">=0.2.0 <2.0.0",
    "@langchain/langgraph-checkpoint": ">=0.0.14 <2.0.0"
  },
  "devDependencies": {
    "@langchain/core": "^1.2.8",
    "@langchain/langgraph": "^1.4.10",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "homepage": "https://mnemohq.com",
  "sideEffects": false
}
